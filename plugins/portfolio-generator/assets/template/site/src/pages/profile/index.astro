---
import projectsData from "../../data/projects.json";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const staticLookup = import.meta.env.PUBLIC_PROFILE_SOURCE === "github";
const profileApiUrl = import.meta.env.PUBLIC_PROFILE_API_URL || "";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portfolio</title>
  </head>
  <body data-base={base} data-static={staticLookup} data-api={profileApiUrl} data-built-user={projectsData.github_user}>
    <header>
      <a class="back" href={`${base}lookup/`}>← auto<span class="accent">portfolio</span></a>
      <button id="save-pdf" class="save-pdf" type="button" title="Load more projects first if you want them in the PDF" disabled>Save as PDF</button>
    </header>
    <main>
      <div class="title">
        <h1 id="name">Loading profile…</h1>
        <p id="meta" class="meta"></p>
      </div>
      <div id="grid" class="grid"></div>
      <p id="empty" class="empty hidden">No public repos found for this account.</p>
      <p id="error" class="err hidden"></p>
      <div class="more-wrap">
        <button id="more" class="hidden">Load more</button>
      </div>
    </main>
  </body>
</html>

<style is:global>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #0d0d0d; color: #eee; font-family: system-ui, sans-serif; max-width: 1100px; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
  header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .back { color: #888; text-decoration: none; font-size: 0.9rem; }
  .accent { color: #2ecc71; }
  .save-pdf { background: #1a1a1a; color: #eee; border: 1px solid #393939; border-radius: 8px; padding: .5rem .85rem; cursor: pointer; font: inherit; font-size: .85rem; }
  .save-pdf:hover:not(:disabled) { border-color: #2ecc71; }
  .save-pdf:disabled { opacity: .5; cursor: wait; }
  h1 { margin: 1rem 0 0.2rem; font-size: 2rem; letter-spacing: -0.02em; }
  .meta { margin: 0 0 1.5rem; color: #9a9a9a; font-size: 0.85rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; }
  .empty, .err { color: #888; text-align: center; padding: 3rem 0; }
  .err { color: #e74c3c; }
  .hidden { display: none; }
  .more-wrap { text-align: center; margin-top: 1.5rem; }
  #more { background: #1a1a1a; color: #eee; border: 1px solid #2e2e2e; padding: 0.6rem 1.4rem; border-radius: 999px; cursor: pointer; font-size: 0.9rem; }
  #more:hover { border-color: #2ecc71; }
  .card { border: 1px solid #2a2a2a; border-radius: 12px; padding: 1.25rem; background: #161616; display: flex; flex-direction: column; gap: 0.6rem; }
  .card-top { display: flex; justify-content: space-between; }
  .tag { font-size: 0.72rem; font-weight: 600; padding: 0.2rem 0.55rem; border-radius: 999px; border: 1px solid; }
  .stars { color: #f1c40f; font-size: 0.8rem; }
  .card h2 { margin: 0; font-size: 1.15rem; }
  .card h2 a { color: #fff; text-decoration: none; }
  .card h2 a:hover { text-decoration: underline; }
  .desc { margin: 0; color: #b8b8b8; font-size: 0.9rem; flex: 1; }
  .pills { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .pill { font-size: 0.7rem; color: #d0d0d0; background: #232323; padding: 0.18rem 0.5rem; border-radius: 6px; }
  .card-foot { display: flex; justify-content: space-between; font-size: 0.78rem; }
  .active { color: #2ecc71; }
  .older-tag { color: #aaa; }
  .archived-tag { color: #7f8c8d; }
  @page { size: A4 portrait; margin: 14mm; }
  @media print {
    :root { color-scheme: light; }
    body { max-width: none; padding: 0; background: #fff !important; color: #111 !important; font-size: 10pt; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    header, .more-wrap { display: none !important; }
    h1 { margin: 0 0 .2rem; }
    .meta { color: #555; margin-bottom: 1rem; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; }
    .card { break-inside: avoid; background: #fff !important; border-color: #bbb; }
    .card h2 a { color: #111; }
    .desc, .older-tag, .archived-tag { color: #444; }
    .pill { background: #eee; color: #222; }
    .active { color: #156b3b; }
    .stars { color: #806000; }
    .err, .empty { display: none; }
  }
</style>

<script>
  import { usefulDescription, categoryFor, fetchReadmeDetails, fetchPublicRepos, projectStatus } from "../../lib/browser-profile.js";
  import { CATEGORY_COLORS } from "../../lib/project-category.js";
  const VALID = /^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,37}[a-zA-Z0-9])?$/;
  const base = document.body.dataset.base || "/";
  const staticLookup = document.body.dataset.static === "true";
  const profileApiUrl = document.body.dataset.api || "";

  // The username comes from the URL path - treat it as untrusted input.
  let username = "";
  try { username = staticLookup ? new URLSearchParams(location.search).get("user") || "" : decodeURIComponent(location.pathname.split("/").filter(Boolean).pop() || ""); }
  catch { location.replace(base + "lookup/"); }
  if (!VALID.test(username)) { location.replace(base + "lookup/"); }

  const grid = document.getElementById("grid");
  const empty = document.getElementById("empty");
  const errorBox = document.getElementById("error");
  const moreBtn = document.getElementById("more");
  const savePdfBtn = document.getElementById("save-pdf");
  let offset = 0;
  let loading = false;
  let repoPromise = null;
  let builtPromise = null;

  async function builtProjects() {
    if (username.toLowerCase() !== (document.body.dataset.builtUser || "").toLowerCase()) return new Map();
    try {
      const response = await fetch(base + "portfolio-data.json");
      if (!response.ok) return new Map();
      const data = await response.json();
      if (data.github_user.toLowerCase() !== username.toLowerCase()) return new Map();
      return new Map(data.projects.map((project) => [project.name.toLowerCase(), project]));
    } catch { return new Map(); }
  }

  async function requestProfile() {
    if (profileApiUrl) {
      try {
        const url = new URL(profileApiUrl);
        url.searchParams.set("user", username);
        url.searchParams.set("offset", String(offset));
        const res = await fetch(url, { signal: AbortSignal.timeout(45000) });
        if (res.ok) return res.json();
        if (res.status === 404) { const error = new Error("Account not found"); error.status = 404; throw error; }
      } catch (error) {
        if (error.status === 404) throw error;
        // Fall through to the browser lookup when the hosted service is unavailable.
      }
    }
    if (!staticLookup) {
      const res = await fetch(`/api/profile?user=${encodeURIComponent(username)}&offset=${offset}`);
      if (!res.ok) { const error = new Error("Profile request failed"); error.status = res.status; throw error; }
      return res.json();
    }
    repoPromise ||= fetchPublicRepos(username);
    builtPromise ||= builtProjects();
    const [{ repos, fetchedAt }, built] = await Promise.all([repoPromise, builtPromise]);
    const visible = repos.slice(offset, offset + 12);
    const projects = await Promise.all(visible.map(async (repo) => {
      const generated = built.get(repo.name.toLowerCase());
      let description = usefulDescription(generated?.description) ? generated.description : "";
      if (!description && usefulDescription(repo.description)) description = repo.description.trim();
      let readme = "";
      if (!description) {
        const details = await fetchReadmeDetails(repo);
        readme = details.text;
        description = details.intro;
      }
      if (!description) description = "No project description is available.";
      let category = categoryFor(repo, description, generated?.category, readme);
      if (category === "Software Project" && !readme) {
        readme = (await fetchReadmeDetails(repo)).text;
        category = categoryFor(repo, description, generated?.category, readme);
      }
      return {
        name: repo.name, repo_url: repo.html_url, category,
        tech_stack: generated?.tech_stack?.length ? generated.tech_stack : repo.language ? [repo.language] : [],
        description,
        status: projectStatus(repo),
        last_commit_at: repo.pushed_at, stars: repo.stargazers_count || 0,
      };
    }));
    const next = offset + visible.length;
    return { username, total_repos: repos.length, shown: visible.length, has_more: next < repos.length, next_offset: next < repos.length ? next : null, generated_at: new Date(fetchedAt).toISOString(), projects };
  }

  function relTime(iso) {
    const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86400000);
    if (days <= 0) return "today";
    if (days === 1) return "yesterday";
    if (days < 30) return days + " days ago";
    const m = Math.floor(days / 30);
    if (m < 12) return m + " month" + (m > 1 ? "s" : "") + " ago";
    const years = Math.floor(m / 12);
    return years + " year" + (years > 1 ? "s" : "") + " ago";
  }

  // All repo content is inserted via textContent/createElement only - never innerHTML.
  function card(p) {
    const el = document.createElement("article");
    el.className = "card";

    const top = document.createElement("div"); top.className = "card-top";
    const tag = document.createElement("span"); tag.className = "tag";
    const color = CATEGORY_COLORS[p.category] || CATEGORY_COLORS["Software Project"];
    tag.textContent = p.category;
    tag.style.cssText = "background:" + color + "22;color:" + color + ";border-color:" + color + "55";
    top.appendChild(tag);
    if (p.stars > 0) { const s = document.createElement("span"); s.className = "stars"; s.textContent = "★ " + p.stars; top.appendChild(s); }

    const h2 = document.createElement("h2");
    const a = document.createElement("a"); a.href = p.repo_url; a.target = "_blank"; a.rel = "noopener noreferrer"; a.textContent = p.name;
    h2.appendChild(a);

    const desc = document.createElement("p"); desc.className = "desc"; desc.textContent = p.description;

    const pills = document.createElement("div"); pills.className = "pills";
    for (const t of p.tech_stack) { const s = document.createElement("span"); s.className = "pill"; s.textContent = t; pills.appendChild(s); }

    const foot = document.createElement("div"); foot.className = "card-foot";
    const st = document.createElement("span");
    if (p.status === "archived") { st.className = "archived-tag"; st.textContent = "Archived on GitHub"; }
    else { st.className = p.status === "inactive" ? "older-tag" : "active"; st.textContent = "updated " + relTime(p.last_commit_at); }
    foot.appendChild(st);

    el.append(top, h2, desc, pills, foot);
    return el;
  }

  async function load() {
    if (loading) return;
    loading = true;
    moreButtonDisabled(true);
    try {
      const data = await requestProfile();
      errorBox.classList.add("hidden");
      document.title = data.username + " | portfolio";
      document.getElementById("name").textContent = data.username;
      document.getElementById("meta").textContent = grid.children.length + data.shown + " of " + data.total_repos + " public repos · generated " + relTime(data.generated_at);
      for (const p of data.projects) grid.appendChild(card(p));
      savePdfBtn.disabled = grid.children.length === 0;
      empty.classList.toggle("hidden", data.total_repos > 0);
      moreBtn.classList.toggle("hidden", !data.has_more);
      if (data.has_more && data.next_offset !== null) {
        offset = data.next_offset;
        moreBtn.classList.remove("hidden");
      }
    } catch (error) {
      errorBox.textContent = error.status === 404 ? "This GitHub account was not found." : (error.status === 403 || error.status === 429) ? "GitHub's request limit was reached. Try again later." : "Network error - try again.";
      errorBox.classList.remove("hidden");
      if (!grid.children.length) document.getElementById("name").textContent = "Unable to load profile";
    }
    hideLoading();
    moreButtonDisabled(false);
    loading = false;
  }

  function hideLoading() { /* placeholder for a spinner removal */ }
  function moreButtonDisabled(v) { moreBtn.disabled = v; moreBtn.textContent = v ? "Loading…" : "Load more"; }

  document.getElementById("more").addEventListener("click", load);
  savePdfBtn.addEventListener("click", () => window.print());
  load();
</script>
